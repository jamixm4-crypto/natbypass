#!/bin/sh /etc/rc.common
# ============================================================
# NatBypass — procd-скрипт для OpenWrt
# Путь: /etc/init.d/natbypass
# Включить: /etc/init.d/natbypass enable && /etc/init.d/natbypass start
# ============================================================

START=99
STOP=10
USE_PROCD=1

PROG=/usr/sbin/natbypass
CONFIG=/etc/natbypass/config.yaml
PIDFILE=/var/run/natbypass.pid

start_service() {
    mkdir -p /etc/natbypass
    
    procd_open_instance
    procd_set_param command "$PROG" start --config "$CONFIG"
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PIDFILE"
    # Перезагрузка по SIGHUP (reload конфига)
    procd_set_param reload_signal HUP
    procd_close_instance
    
    logger -t natbypass "Сервис запущен"
}

stop_service() {
    logger -t natbypass "Сервис остановлен"
}

reload_service() {
    logger -t natbypass "Перезагрузка конфигурации..."
    procd_send_signal natbypass.* HUP
}

service_triggers() {
    # Перезапуск при изменении сетевых интерфейсов
    procd_add_reload_trigger "network"
}
