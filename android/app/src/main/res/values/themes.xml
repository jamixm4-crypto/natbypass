<resources>
    <!-- Base theme: DayNight so system + Compose handles dark/light.
         NoActionBar because Compose TopAppBar is used.
         Edge-to-edge: transparent status/nav bars, Compose uses WindowInsets. -->
    <style name="Theme.NatBypass" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
