<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Top Navigation Toolbar -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛸 NatBypass"
            android:textColor="@color/accent_purple"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCheckUpdate"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Проверить обновления"
            app:srcCompat="@drawable/ic_refresh"
            app:tint="@color/green_bright" />

        <ImageButton
            android:id="@+id/btnClearCache"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Очистить кэш"
            app:srcCompat="@drawable/ic_refresh"
            app:tint="@color/red_bright" />

        <ImageButton
            android:id="@+id/btnShareQR"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Поделиться QR"
            app:srcCompat="@drawable/ic_share"
            app:tint="@color/accent_blue" />

        <ImageButton
            android:id="@+id/btnScanQR"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/title_qr_scanner"
            app:srcCompat="@drawable/ic_qr_code"
            app:tint="@color/accent_blue" />

        <ImageButton
            android:id="@+id/btnDiagnostics"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/title_diagnostics"
            app:srcCompat="@drawable/ic_diagnostics"
            app:tint="@color/text_muted" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/title_settings"
            app:srcCompat="@drawable/ic_settings"
            app:tint="@color/text_muted" />
    </LinearLayout>

    <!-- Telemetry Metrics Grid -->
    <LinearLayout
        android:id="@+id/metricsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/headerLayout">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Узлов в сети"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tvPeersCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 онлайн"
                android:textColor="@color/green_bright"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RTT Пинг"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tvAvgPing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 ms"
                android:textColor="@color/accent_blue"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="10dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Канал связи"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/tvSignalingMode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ P2P Direct"
                android:textColor="@color/accent_purple"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main VPN Toggle Card -->
    <LinearLayout
        android:id="@+id/statusCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="18dp"
        app:layout_constraintTop_toBottomOf="@id/metricsLayout">

        <FrameLayout
            android:id="@+id/btnVpnToggle"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:background="@drawable/bg_vpn_button"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/ivVpnIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_vpn_lock"
                app:tint="@color/white" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/vpn_status_disconnected"
            android:textColor="@color/red_bright"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIpAddress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Нажмите для подключения"
            android:textColor="@color/text_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvPublicIpAndStun"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="🌐 Внешний IP: Определяется..."
            android:textColor="@color/accent_blue"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- AWG Mode Selector Card -->
    <LinearLayout
        android:id="@+id/awgCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_card"
        android:orientation="horizontal"
        android:padding="10dp"
        app:layout_constraintTop_toBottomOf="@id/statusCard">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🛡️ Режим защиты:"
            android:textColor="@color/text_primary"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spAwgMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Peers Header & List -->
    <TextView
        android:id="@+id/tvPeersHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="👥 Устройства в вашей P2P Mesh сети"
        android:textColor="@color/accent_blue"
        android:textSize="14sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/awgCard" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvPeers"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvPeersHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
