# ============================================================
# NatBypass — пример конфигурации
# Скопируйте в config.yaml и заполните свои значения
# Переменные окружения: NATBYPASS_<SECTION>_<KEY> (uppercase)
# Пример: NATBYPASS_APP_LOGLEVEL=debug
# ============================================================

app:
  name: "NatBypass"
  version: "1.0.0"
  # Уровень логирования: debug, info, warn, error
  log_level: "info"
  # Файл лога (пусто = stdout)
  log_file: ""
  # ID устройства (генерируется автоматически если пусто)
  device_id: ""
  # Интервал публикации (секунд)
  publish_interval: 60

web_ui:
  enabled: true
  # Порт Web UI
  port: 8080
  # HTTP Basic Auth (оставьте пустым для отключения)
  username: "admin"
  password: "changeme"

network:
  # STUN серверы для определения внешнего IP и hole punching
  stun_servers:
    - "stun.l.google.com:19302"
    - "stun1.l.google.com:19302"
    - "stun.cloudflare.com:3478"
    - "stun.stunprotocol.org:3478"
  # UPnP/NAT-PMP для автоматического проброса портов
  upnp_enabled: true
  # Fallback API для определения публичного IP
  ip_apis:
    - "https://api.ipify.org?format=json"
    - "https://ifconfig.me/ip"
    - "https://icanhazip.com"
    - "https://checkip.amazonaws.com"
    - "https://ipecho.net/plain"
    - "https://api4.my-ip.io/ip"
  # Таймаут для запросов определения IP (секунд)
  ip_timeout: 10
  # DNS over HTTPS (для обхода блокировок)
  doh_enabled: false
  doh_provider: "https://cloudflare-dns.com/dns-query"
  # SOCKS5 прокси для сигнальных каналов (пусто = без прокси)
  socks5_proxy: ""

# ── Сигнальные каналы ────────────────────────────────────────
# Список приоритизирован: используется первый доступный
# При ошибке автоматически переключается на следующий
signaling:
  channels:
    # Telegram Bot API
    - type: "telegram"
      priority: 1
      enabled: true
      params:
        # Токен бота от @BotFather
        token: "YOUR_BOT_TOKEN_HERE"
        # ID чата/канала (числовой, например -1001234567890)
        chat_id: "YOUR_CHAT_ID_HERE"
        # Опционально: SOCKS5 для доступа к Telegram
        proxy: ""

    # MQTT брокер
    - type: "mqtt"
      priority: 2
      enabled: true
      params:
        # URL брокера: tcp://host:1883 или ssl://host:8883
        broker_url: "tcp://mqtt.eclipseprojects.io:1883"
        # Топик (лучше сделать уникальным для вашей сети)
        topic: "natbypass/mynetwork/peers"
        # ID клиента (пусто = генерируется из device_id)
        client_id: ""
        username: ""
        password: ""

    # HTTP Webhook (например Cloudflare Worker или свой VPS)
    - type: "webhook"
      priority: 3
      enabled: false
      params:
        # URL для публикации данных (POST)
        post_url: "https://your-worker.workers.dev/publish"
        # URL для получения данных (GET с polling)
        poll_url: "https://your-worker.workers.dev/peers"
        # Секрет для HMAC-SHA256 подписи
        secret: "your-webhook-secret"

    # DNS TXT через Cloudflare API
    - type: "dns"
      priority: 4
      enabled: false
      params:
        # Cloudflare API Token (нужны права DNS:Edit)
        cf_api_token: "YOUR_CF_API_TOKEN"
        # Zone ID из Cloudflare dashboard
        zone_id: "YOUR_ZONE_ID"
        # Поддомен для TXT записи (например: nb._my-net.example.com)
        record_name: "natbypass.example.com"

# ── WireGuard mesh ────────────────────────────────────────────
wireguard:
  enabled: false
  # Имя интерфейса (wg0 для Linux, Ethernet для Windows)
  interface: "wg0"
  # Порт прослушивания
  listen_port: 51820
  # Путь к файлу приватного ключа WG
  # (генерируется автоматически при первом запуске)
  private_key_file: "/etc/natbypass/wg-private.key"
  # Адрес этого устройства в WG-сети (CIDR)
  address: "10.200.0.1/24"
  # DNS для туннеля (опционально)
  dns: ""
  # MTU (0 = авто)
  mtu: 0

# ── Шифрование NaCl/Box ───────────────────────────────────────
crypto:
  # Публичный ключ этого устройства (hex, генерируется автоматически)
  public_key: ""
  # Приватный ключ этого устройства (hex, НЕ раскрывать!)
  private_key: ""
  # Путь к файлу ключей (альтернатива встроенным ключам)
  keys_file: "/etc/natbypass/nacl-keys.json"
  # Список доверенных публичных ключей других устройств
  # (пусто = принимать от всех, небезопасно)
  trusted_keys: []
  # - "hex_public_key_device_2"
  # - "hex_public_key_device_3"

# ── Daemon/Service настройки ──────────────────────────────────
daemon:
  # PID файл
  pid_file: "/var/run/natbypass.pid"
  # Логирование в syslog (только Linux)
  syslog_enabled: false
  # Задержка перед перезапуском после ошибки (секунд)
  restart_delay: 5

# UDP Relay / WSS Relay — ⠫㭨 �।�� ३ ४ ५ ।᫮ (Port 443)
relay:
  enabled: false
  # WSS-ॣ (WebSocket Secure, port 443) — TCP fallback
  wss_server: ""
  # UDP-ॣ — ०⪨ ०ᯫᬠ IP- ४ ᥢ UDP
  # ০⠭: < 80ms, throughput > 1 Mbps
  udp_server: "relay.natbypass.example.com:47832"
  # 32- ०⥭⮢ ९ (hex, 64 ᨬ) ।ᯥ ।  ChaCha20-Poly1305
  # ०ᯮ ⮧ । ०ᥢ, ९ ᯨᮬ ।০ privKey
  session_key: "your-32-byte-hex-session-key-here-aabbccdd"